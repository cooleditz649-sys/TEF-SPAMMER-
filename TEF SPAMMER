-- SHORT MESSAGE BUILDER - PREFIX 60
local function buildMessage(targetName, offset)
    local output={} table.insert(output,head)
    if targetName~="" then table.insert(output,"["..targetName.."]") end
    local pos=((offset-1)%#spamWords)+1 table.insert(output,spamWords[pos])
    if emojiEnabled then local e if cycleEnabled then e=emojis[emojiIndex] emojiIndex=emojiIndex+1 if emojiIndex>#emojis then emojiIndex=1 end else e=emojis[math.random(1,#emojis)] end table.insert(output,e) end
    return table.concat(output," ")
end

local function sendMessage(text) local ch=getChannel() if ch then pcall(function() ch:SendAsync(text) end) else pcall(function() local ev=ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents") if ev and ev:FindFirstChild("SayMessageRequest") then ev.SayMessageRequest:FireServer(text,"All") end end) end end

